# Utsav Celebration & Event Planner Environment Variables
# ZERO CONFIG: Works out-of-the-box without keys using Demo Mode.
# Add either Gemini or Anthropic API key to enable live GenAI capabilities.

# Google Gemini API Key (Default model: gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Key (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & App Configuration
NODE_ENV=development

